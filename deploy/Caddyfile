# Agents: the full libredesk app (login, inboxes, admin). Libredesk's Root URL points here.
{$DESK_DOMAIN} {
	encode zstd gzip
	# Keep in step with app.server.max_body_size in config.toml (110MB).
	request_body {
		max_size 110MB
	}

	# The agent app may not be framed by other sites (clickjacking). Upstream sets the same
	# headers on the app page from v2.9.0 (serveIndexPage); this can go after that merge.
	# The chat widget, help center and CSAT pages are embedded or linked elsewhere and stay
	# frameable; My Tickets sends its own stricter frame-ancestors 'none'.
	@agentApp not path /widget /widget/* /widget.js /hc /hc/* /csat/* /my-tickets /my-tickets/*
	header @agentApp {
		Content-Security-Policy "frame-ancestors 'self'"
		X-Frame-Options SAMEORIGIN
		match header Content-Type text/html*
	}

	# Deploy agent status (deploy/agent/deploy_agent.py), watched by the approved
	# GitHub deploy job. Only deployment id, version and state; no secrets.
	handle /.well-known/encatch-deploy.json {
		rewrite * /status.json
		root * /srv/deploy-status
		header Cache-Control "no-store"
		file_server
	}

	handle {
		reverse_proxy app:9000
	}
}

# Customers: only customer-facing paths reach libredesk. Anything else (typos, /, /login,
# /admin) gets a static "open Support from your dashboard" page, so customers never see
# the agent login.
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 110MB
	}

	@customer path /my-tickets /my-tickets/* \
 /hc/* /api/v1/public/* /sitemap.xml /robots.txt \
 /csat/* /api/v1/csat/* \
 /widget /widget.js /widget/* /api/v1/widget/* \
 /uploads/* /static/public/* /assets/* /images/* \
 /health
	handle @customer {
		reverse_proxy app:9000
	}

	# Agent password links sent before the domain split pointed at this domain; send them
	# (with their token) to the agents' domain instead of the customer 404 page.
	@agentLinks path /set-password /reset-password
	handle @agentLinks {
		redir https://{$DESK_DOMAIN}{uri} 302
	}

	handle / {
		root * /srv/customer-site
		rewrite * /index.html
		file_server
	}

	handle {
		root * /srv/customer-site
		rewrite * /index.html
		file_server {
			status 404
		}
	}
}

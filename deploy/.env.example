# Copy to .env on the server (install.sh generates the secrets if missing).
# Never commit .env.

# App image tag from ghcr.io/get-encatch/libredesk. Change deliberately: app
# upgrades run database migrations on start.
LIBREDESK_VERSION=v2.8.0-encatch.1

DOMAIN=support.encatch.com

POSTGRES_USER=libredesk
POSTGRES_DB=libredesk
POSTGRES_PASSWORD=

# 32 characters. Generate with: openssl rand -hex 16
LIBREDESK_ENCRYPTION_KEY=

# Initial password for the "System" admin user, used only on first install.
LIBREDESK_SYSTEM_USER_PASSWORD=
